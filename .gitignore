# Allowlist: ignore everything, then re-include only my own files.
/*
!/.gitignore
!/README.md
!/install.sh
!/keys.json
!/settings.json
!/programs.json
!/fonts/
!/themes/
!/layouts/
!/mods/

# Themes: only mine (atom-one-dark and win98 ship with Herdr)
/themes/atom-one-dark.json
/themes/win98.json

# Layouts: only mine (main, terminals, win98 are Herdr's; .state holds clicks)
/layouts/*
!/layouts/dev-workspace.json

# Mods: only mine. Convention: px-*, dev-*, plus the ones listed here.
/mods/*
!/mods/px-*/
!/mods/dev-*/
!/mods/prs/
!/mods/run/

# Files Herdr rewrites on every start
**/gpui-kit.d.ts
**/herdr.d.ts
**/jsconfig.json
*.error
*.reset-*
*.old-*
